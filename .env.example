# Lokale Entwicklung — kopieren nach .env (wird nicht eingecheckt).
# Werte passen zum Compose-Stack (`docker compose up -d --wait`).

# --- Backend (apps/api, apps/mcp) ---
# Owner-Connection: faehrt die Migrationen (who2be-migrate) und ist im
# On-Prem-/Dev-Betrieb auch die Laufzeit-Connection der App.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/who2be

# RLS-Cloud-Haertung (Plan R1/R2): im Cloud-Betrieb verbindet die App zur
# Laufzeit als nicht-privilegierte Rolle `who2be_app` (NOSUPERUSER,
# NOBYPASSRLS), die Migration 0036 anlegt. Das Passwort setzt der Betreiber
# out-of-band (`ALTER ROLE who2be_app WITH PASSWORD '...'`). Leer ⇒ Fallback
# auf DATABASE_URL (On-Prem/Dev laufen als Owner, der RLS ohnehin umgeht —
# kein App-SQL-Unterschied).
# APP_DATABASE_URL=postgresql://who2be_app:CHANGE_ME@localhost:5432/who2be

# JWT_SECRET muss EXAKT dem Auth-Provider-JWT-Secret entsprechen
# - Compose-Smoke: identisch zu GOTRUE_JWT_SECRET unten (Default fuer
#   docker-compose ist `dev-jwt-secret-change-me-32chars-min`).
# - Cloud (spaeter): Supabase Studio -> Project Settings -> API -> JWT Secret.
# Mismatch => die API lehnt jedes Web-Login-JWT mit 401 ab.
# Mindestlaenge: 32 Zeichen (sonst warnt der API-Start).
JWT_SECRET=dev-jwt-secret-change-me-32chars-min

# CORS — komma-separierte Liste erlaubter Origins fuer den Browser.
# Compose-Smoke: nur Vite-Dev-Port. MS-2 ergaenzt die Hetzner-App-Domain.
CORS_ORIGINS=http://localhost:5173

# Rate-Limit fuer schreibende Endpoints (POST/PUT). slowapi-Syntax (`N/period`).
# Pro Bearer-Token-Hash, sonst pro IP. Default 30/minute.
# RATE_LIMIT_WRITE=30/minute

# Strukturierte Logs (ADR-0007): "json" fuer Prod-Aggregation,
# "console" fuer lesbares Dev-Tail.
# LOG_FORMAT=json

# Docs-Toggle (H5 / F-13). Default false: /docs, /redoc, /openapi.json sind aus.
# true nur fuer lokales Debugging — in Prod hat Caddy keinen Auth-Layer davor.
# WHO2BE_DOCS_PUBLIC=false

# --- Editionen / Entitlements (Track D, 12-Factor: nur Env, .env gitignored) ---
# Ein Codebase, zwei Build-Profile (ADR-0029): die Read-Seite ist editionsneutral
# und nach diesem Flag aufgeloest; die Billing-Schreibseite (Mollie/Checkout) lebt
# im optionalen Paket who2be-billing und ist im On-Prem-Build physisch nicht
# enthalten (Docker-Target `runtime` ohne `--group billing`; Cloud:
# `runtime-cloud`). Default `onprem` (unbegrenztes OSS-Entitlement, kein Billing).
# Das Mollie-Billing erfordert zusaetzlich den Cloud-Build — das Flag allein
# schaltet es nicht scharf.
# WHO2BE_EDITION=onprem
#
# Semantische Suche (ADR-0046, optional). AUS by default. An ⇒ Passagen und
# Anfragen werden zu Vektoren; die Suche findet dann auch Umschreibungen und
# sprachuebergreifend (deutsche Frage, englischer Inhalt).
# Voraussetzung: `uv sync --group embeddings` (ONNX-Runtime + Modell) und eine
# Postgres-Instanz mit der `vector`-Extension. Fehlt eins von beidem, laeuft die
# Suche unveraendert im Volltext-Modus weiter — kein Fehler.
# Gerechnet wird LOKAL im eigenen Prozess: kein Text verlaesst das Deployment.
# WHO2BE_EMBEDDINGS_ENABLED=false
# WHO2BE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#
# On-Prem-Lizenz (optional): signierter Lizenz-Token, offline gegen K_pub
# (licensing/keys/signing_key.pub, Ed25519) verifiziert — KEIN Phone-Home.
# NIE der Private-Key. Leer ⇒ reines OSS (unbegrenzt).
# WHO2BE_LICENSE_KEY=
#
# Cloud-Billing-Webhook: Shared Secret des Zahlungsanbieters (Stripe/Mollie) fuer
# die Signaturpruefung von POST /v1/billing/webhook. Leer ⇒ Webhook lehnt jede
# Lieferung ab (fail closed). Nur in der Cloud-Edition relevant.
# WHO2BE_BILLING_WEBHOOK_SECRET=
#
# Mollie-Pull-Billing (Plan §3.2, nur Cloud-Edition). Mollie liefert beim Webhook
# nur die Zahlungs-`id`; die App fetcht das Objekt aktiv ueber diesen API-Key
# (live_*/test_*). Leer ⇒ Mollie-Checkout/-Webhook liefern 503.
# MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optionaler Zusatz-Token fuer den Webhook-Pfad (?token=…). Mollie signiert nicht;
# leer ⇒ kein Token-Gate (Pull-Verifikation bleibt die Hauptsicherung).
# MOLLIE_WEBHOOK_SECRET=
# Absolute https-Webhook-URL (Mollie akzeptiert kein localhost). Leer ⇒ Zahlungen/
# Subscriptions werden ohne webhookUrl angelegt (lokales Dev).
# MOLLIE_WEBHOOK_URL=https://api.who2be.example/v1/billing/mollie/webhook
#
# Betreiber-Allowlist fuer den manuellen Entitlement-Override (ADR-0028,
# Standards-Review 2026-07-20 LIC-1): kommaseparierte User-UUIDs, die
# POST /v1/workspaces/{ws}/billing/override schreiben duerfen (zusaetzlich
# aal2-Pflicht). Leer ⇒ niemand (fail closed). Nur Cloud-Edition relevant —
# ohne gesetzte Variable ist der Support-/Kulanz-Pfad bewusst tot.
# WHO2BE_BILLING_OVERRIDE_OPERATORS=
#
# On-Prem-Bootstrap: beim ersten Boot ohne Tenant wird fuer diese Email ein
# Admin + Personal-Org + Default-Workspace deterministisch geseedet.
# WHO2BE_BOOTSTRAP_ADMIN_EMAIL=

# Supabase Cloud — nur fuer Cloud-Smoke noetig (nicht fuer den Compose-Stack).
# SUPABASE_URL=

# Invitation-Mail via GoTrue (Phase 2.3). Best-effort: ohne diese Werte wird
# der Mail-Versand uebersprungen — der Klartext-Token kommt trotzdem im
# 201-Body der POST /invitations zurueck und kann manuell geteilt werden.
# SUPABASE_SERVICE_KEY ist der GoTrue/Supabase service_role-Key (Admin).
# SUPABASE_SERVICE_KEY=
# Basis-URL der Web-App fuer den Accept-Link {WEB_BASE_URL}/invitations/{token}/accept.
# WEB_BASE_URL=http://localhost:5173

# OAuth-Remote-MCP-Connector (ADR-0034-Folge) — die API ist OAuth-2.1-Authorization-
# Server. OAUTH_ISSUER_URL = oeffentliche API-Basis (= Issuer), OAUTH_CONSENT_URL =
# die Web-Consent-Seite, MCP_RESOURCE_URL = kanonische MCP-Resource-URL (RFC-8707-
# Audience; MUSS mit der vom MCP-Server advertisierten Resource uebereinstimmen,
# d.h. {MCP_PUBLIC_URL}{WHO2BE_HTTP_PATH}).
# OAUTH_ISSUER_URL=http://localhost:8000
# OAUTH_CONSENT_URL=http://localhost:5173/oauth/consent
# MCP_RESOURCE_URL=http://127.0.0.1:8765/mcp
# Auf der MCP-Server-Seite (apps/mcp, nur HTTP-Transport):
# WHO2BE_OAUTH_ISSUER_URL=http://localhost:8000
# WHO2BE_MCP_PUBLIC_URL=http://127.0.0.1:8765

# MFA / TOTP (WP-F, Befund S1) — Zwei-Faktor per TOTP. Im Compose-`auth`-Service
# default AN (GOTRUE_MFA_TOTP_ENROLL_ENABLED/VERIFY_ENABLED). Nach einer
# verifizierten TOTP-Challenge setzt GoTrue den JWT-Claim `aal=aal2`; die API
# erzwingt aal2 fuer alle Admin-Aktionen (core/security.require_aal2). Admins
# MUESSEN einen TOTP-Faktor einrichten (Account-Einstellungen) — Details in
# docs/mfa-admin.md. Die Werte hier nur setzen, um die Defaults zu ueberschreiben.
# GOTRUE_MFA_TOTP_ENROLL_ENABLED=true
# GOTRUE_MFA_TOTP_VERIFY_ENABLED=true
# GOTRUE_MFA_MAX_ENROLLED_FACTORS=10
#
# On-Prem-MFA-Haertung (SEC-1): JWTs OHNE aal-Claim (Legacy-/Magic-Link-/
# Test-Tokens) laesst das Admin-MFA-Gate On-Prem per Default durch (fail-open,
# mit Warn-Log `aal_missing_onprem`). true ⇒ fehlender Claim wird auch On-Prem
# hart abgelehnt (fail-closed wie in der Cloud). Default false.
# WHO2BE_REQUIRE_MFA_ONPREM=false

# Social-Login / SSO (Track K) — lokal default AUS. Zum Testen einen Provider
# aktivieren und die Credentials aus der Developer-Console eintragen. Die
# Redirect-URI muss http://localhost:9999/auth/v1/callback sein (Compose-Default).
# Prod-Aequivalent liegt in deploy/hetzner/supabase/.env.example.
# GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
# GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
# GOTRUE_EXTERNAL_GOOGLE_SECRET=
# GOTRUE_EXTERNAL_GITHUB_ENABLED=true
# GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=
# GOTRUE_EXTERNAL_GITHUB_SECRET=

# ======================================================================
# === Cloud-Edition LOKAL (docker-compose.cloud.yml) ===================
# ======================================================================
# Diese Vars greifen NUR, wenn der cloud-local-Overlay mitgestartet wird:
#   docker compose -f docker-compose.yml -f docker-compose.cloud.yml up -d
# Ohne Overlay laeuft der dev-Stack oben (onprem, autoconfirm, memory://) —
# diese Werte bleiben dann ungenutzt. Reise-Doku: docs/cloud-local-smoke.md.
#
# Passwort der nicht-privilegierten Laufzeit-Rolle `who2be_app` (Migration 0036,
# RLS aktiv). Der One-Shot `set-app-role-password` setzt es beim Hochfahren und
# die API verbindet damit ueber APP_DATABASE_URL. Lokal frei waehlbar; in Prod
# kommt es aus dem Secret-Manager (Plan §3.3), NICHT aus dem Repo.
# APP_DB_PASSWORD=who2be_app_local_pw
#
# Mollie-Test-Modus fuer den Upgrade-/Billing-Smoke. Test-Key aus dem Mollie-
# Dashboard (Developers → API keys). Leer ⇒ Checkout/Webhook liefern 503.
# MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Mollie ruft den Webhook nur ueber eine oeffentliche https-URL auf (kein
# localhost). Lokal per Tunnel exponieren (ngrok/cloudflared) und die Tunnel-URL
# hier eintragen. Leer ⇒ Zahlungen werden ohne webhookUrl angelegt (Pull manuell).
# MOLLIE_WEBHOOK_URL=https://<tunnel-host>/v1/billing/mollie/webhook
# MOLLIE_WEBHOOK_SECRET=
#
# GoTrue→Mailpit-SMTP. Mailpit nimmt im Dev-Modus jede Anmeldung an; die Defaults
# unten reichen fuer den lokalen Smoke. Mailpit-UI: http://localhost:8025.
# GOTRUE_SMTP_USER=dev
# GOTRUE_SMTP_PASS=dev
# GOTRUE_SMTP_ADMIN_EMAIL=no-reply@who2be.local
# GOTRUE_SMTP_SENDER_NAME=Who2Be
#
# Rate-Limit-Storage (Track N). Der Overlay setzt RATE_LIMIT_STORAGE_URI auf
# redis://redis:6379 fest; hier nur zur Doku der Default-Variante.
# RATE_LIMIT_STORAGE_URI=memory://
#
# Service-Role-Key fuer GoTrue-Admin-Mails (Invitation). Generieren wie in
# deploy/hetzner/supabase/.env.example beschrieben. Optional fuer den Smoke.
# SUPABASE_SERVICE_KEY=
# WEB_BASE_URL=http://localhost:5173

# --- Web (apps/web) ---
VITE_API_BASE_URL=http://localhost:8000

# Web spricht supabase-js gegen den Auth-Gateway (Compose-Service `auth-gateway`,
# proxied auf GoTrue). Lokal: http://localhost:9999. MS-2 ersetzt das durch
# die Hetzner-Domain mit Kong-Gateway.
VITE_SUPABASE_URL=http://localhost:9999
# Dev-Anon-Key — wird vom Self-hosted-GoTrue nicht streng validiert, kann aber
# nicht leer sein, weil supabase-js sonst nicht initialisiert. Nicht in Prod nutzen.
VITE_SUPABASE_ANON_KEY=dev-anon-key-not-used-by-gotrue

# Edition des Web-Bundles (ADR-0029, Build-Arg/Compile-Time): Default onprem —
# die Billing-UI (features/billing) wird dann aus dem Bundle tree-geshaked.
# `cloud` setzen, um die Billing-UI in den Web-Build zu bekommen (z. B. fuer
# den Cloud-Smoke, docs/cloud-local-smoke.md). Wirkt NUR beim (Re-)Build des
# web-Images, nicht zur Laufzeit.
# VITE_WHO2BE_EDITION=onprem

# Public-Signup abschalten. ZWEI Schalter, IMMER GEMEINSAM setzen:
#   - GOTRUE_DISABLE_SIGNUP=true  → Backend-Durchsetzung (GoTrue weist signUp
#     mit 422 ab; greift auch gegen direkte API-Aufrufe). Build-Zeit unabhaengig.
#   - VITE_WHO2BE_SIGNUP_DISABLED=true → versteckt die Signup-UI (Login-Link +
#     /signup-Route). Build-Arg (Vite, Compile-Time). Einladungen funktionieren
#     unabhaengig davon weiter (Members-Seite → Invite per Mail).
# GOTRUE_DISABLE_SIGNUP=false
# VITE_WHO2BE_SIGNUP_DISABLED=false
