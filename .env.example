# Lokale Entwicklung — kopieren nach .env (wird nicht eingecheckt).
# Werte passen zum docker-compose-Postgres-Stub.

# --- Backend (apps/api, apps/mcp) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/who2be

# Supabase — ab Phase 1 (Auth) befuellen.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# JWT_SECRET muss EXAKT dem Supabase-Project-JWT-Secret entsprechen
# (Supabase Studio -> Project Settings -> API -> JWT Settings -> JWT Secret).
# Mismatch => die API lehnt jedes Web-Login-JWT mit 401 ab.
JWT_SECRET=

# CORS — komma-separierte Liste erlaubter Origins fuer den Browser.
# Lokal reicht der Vite-Dev-Server; in MS-2 kommt die Hetzner-App-Domain dazu.
# CORS_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ORIGINS=http://localhost:5173

# --- Web (apps/web) ---
VITE_API_BASE_URL=http://localhost:8000
# Supabase-Connect aus dem Web (Anon-Key, kein Service-Role). Werte aus
# Supabase Studio -> Project Settings -> API.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
