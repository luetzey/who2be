# Lokale Entwicklung — kopieren nach .env (wird nicht eingecheckt).
# Werte passen zum Compose-Stack (`docker compose up -d --wait`).

# --- Backend (apps/api, apps/mcp) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/who2be

# JWT_SECRET muss EXAKT dem Auth-Provider-JWT-Secret entsprechen
# - Compose-Smoke: identisch zu GOTRUE_JWT_SECRET unten (Default fuer
#   docker-compose ist `dev-jwt-secret-change-me-32chars-min`).
# - Cloud (spaeter): Supabase Studio -> Project Settings -> API -> JWT Secret.
# Mismatch => die API lehnt jedes Web-Login-JWT mit 401 ab.
# Mindestlaenge: 32 Zeichen (sonst warnt der API-Start).
JWT_SECRET=dev-jwt-secret-change-me-32chars-min

# CORS — komma-separierte Liste erlaubter Origins fuer den Browser.
# Compose-Smoke: nur Vite-Dev-Port. MS-2 ergaenzt die Hetzner-App-Domain.
CORS_ORIGINS=http://localhost:5173

# Supabase Cloud — nur fuer Cloud-Smoke noetig (nicht fuer den Compose-Stack).
# SUPABASE_URL=

# --- Web (apps/web) ---
VITE_API_BASE_URL=http://localhost:8000

# Web spricht supabase-js gegen den Auth-Gateway (Compose-Service `auth-gateway`,
# proxied auf GoTrue). Lokal: http://localhost:9999. MS-2 ersetzt das durch
# die Hetzner-Domain mit Kong-Gateway.
VITE_SUPABASE_URL=http://localhost:9999
# Dev-Anon-Key — wird vom Self-hosted-GoTrue nicht streng validiert, kann aber
# nicht leer sein, weil supabase-js sonst nicht initialisiert. Nicht in Prod nutzen.
VITE_SUPABASE_ANON_KEY=dev-anon-key-not-used-by-gotrue
