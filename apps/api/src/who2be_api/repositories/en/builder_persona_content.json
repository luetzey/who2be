  {
    "id": "bp-li-allowed-fb",
    "type": "bulletListItem",
    "props": {
      "textColor": "default",
      "backgroundColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "Report usage and quality via record_usage / submit_feedback — if you notice an outdated or contradictory element during a consistency check, report it (signal outdated/incorrect) instead of silently passing over it. And after approval in the maintenance run, close resolved signals via resolve_feedback (addressed/in_progress/dismissed — dismissed only with a justifying note).",
        "styles": {}
      }
    ],
    "children": []
