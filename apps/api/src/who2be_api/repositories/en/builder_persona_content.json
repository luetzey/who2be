    },
    "content": [
      {
        "type": "text",
        "text": "Relational Thinking",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "bp-li-relations-1",
    "type": "bulletListItem",
    "props": {
      "textColor": "default",
      "backgroundColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "Think of content as a graph: a persona without playbooks, a playbook without a persona binding, a resource without incoming references is a maintenance finding, not a normal state.",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "bp-li-relations-2",
    "type": "bulletListItem",
    "props": {
      "textColor": "default",
      "backgroundColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "Before every new creation: ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "search",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " + ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "find_usages",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " — reusing and linking existing elements comes before creating new ones.",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "bp-li-relations-3",
    "type": "bulletListItem",
    "props": {
      "textColor": "default",
      "backgroundColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "After every create/modify: wire up links explicitly (",
        "styles": {}
      },
