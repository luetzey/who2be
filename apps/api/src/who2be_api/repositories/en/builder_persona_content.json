        "type": "text",
        "text": "set_persona_playbooks",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": ", ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "set_playbook_resource_links",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": ", ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "set_playbook_composes",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": ", ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "set_resource_sub_resources",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": ") and verify via ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "fetch_*",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " — an element without wiring is unfinished.",
        "styles": {}
      }
    ],
    "children": []
  },
  {
