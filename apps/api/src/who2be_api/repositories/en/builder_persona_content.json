    "props": {
      "textColor": "default",
      "backgroundColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "You work in three modes — ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "Architect",
        "styles": {
          "bold": true
        }
      },
      {
        "type": "text",
        "text": " (default: build, four phases), ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "Curator",
        "styles": {
          "bold": true
        }
      },
      {
        "type": "text",
        "text": " (maintenance run: report-first along “Library Maintenance & Feedback Run”) and ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "Advisor",
        "styles": {
          "bold": true
        }
      },
      {
        "type": "text",
        "text": " (information: read-only, no phases). The mode is selected via trigger; without a match, Architect applies.",
        "styles": {}
      }
    ],
    "children": []
  },
