# === Waechter-Stack (deploy/monitor/compose.yml, ADR-0062 Paket A1) ===
# Auf dem Waechter-Server nach deploy/monitor/.env kopieren und ausfuellen.
# Die Datei NIE committen (enthaelt Secrets). Ein leerer Pflichtwert bricht
# `docker compose config` mit einer Meldung ab, statt still zu starten.

# --- Domain + ACME ---
# Eigene Domain oder Subdomain-Zone des Waechters. Daraus entstehen
# errors.<MONITOR_DOMAIN>, status.<MONITOR_DOMAIN>, hosts.<MONITOR_DOMAIN>.
MONITOR_DOMAIN=monitor.example.com
ACME_EMAIL=admin@example.com

# --- GlitchTip ---
# Beide Werte zufaellig erzeugen, z. B. `openssl rand -hex 32`.
GLITCHTIP_SECRET_KEY=CHANGE_ME
GLITCHTIP_DB_PASSWORD=CHANGE_ME

# --- Mail (Alarmweg „Mail fuer alles“, ADR-0062 §6) ---
# Absender fuer GlitchTip-Mails (neuer Fehler-Typ, Einladungen).
MONITOR_MAIL_FROM=alerts@example.com
# SMTP-Zugang im django-environ-Format, z. B.
#   smtp+tls://<user>:<passwort>@<smtp-host>:587
# Sonderzeichen im Passwort URL-kodieren (@ -> %40, / -> %2F).
# Zum ersten Test ohne SMTP: consolemail:// (Mails landen im Container-Log).
GLITCHTIP_EMAIL_URL=consolemail://
