# === Hetzner Prod-App-Stack (deploy/hetzner/who2be/docker-compose.yml) ===
# Auf dem Hetzner-Server nach deploy/hetzner/.env kopieren und ausfuellen.

# --- Domain + ACME ---
DOMAIN=example.com                       # api.<DOMAIN> und app.<DOMAIN>
ACME_EMAIL=admin@example.com             # Let's-Encrypt-Kontakt-Adresse

# --- Image-Tags (C4 setzt diese per CI/CD auf den Commit-SHA) ---
API_IMAGE_TAG=latest
WEB_IMAGE_TAG=latest
MCP_IMAGE_TAG=latest

# --- Backend ---
# DATABASE_URL zeigt auf den Supabase-Postgres-Service-Namen (Task C2).
DATABASE_URL=postgresql://supabase_admin:CHANGE_ME@db:5432/postgres

# JWT_SECRET muss EXAKT dem Supabase-Project-JWT-Secret entsprechen.
# Mindestens 32 Zeichen (sonst Lifespan-Crash, siehe docs/security-findings.md F-08).
JWT_SECRET=CHANGE_ME_minimum_32_chars

# Issuer-Pruefung im API-Auth-Pfad (F-03).
SUPABASE_URL=https://supabase.example.com

# Komma-separierte CORS-Whitelist — nur die App-Domain.
CORS_ORIGINS=https://app.example.com

# Optional — Default 30/minute (apps/api/src/who2be_api/core/config.py).
# RATE_LIMIT_WRITE=30/minute

# Optional — Default json.
# LOG_FORMAT=json

# Docs-Toggle (H5 / F-13). Default false: /docs, /redoc, /openapi.json sind aus.
# Aktivieren nur fuer einmaliges Debugging gegen Prod, sonst stehen Schema und
# Routes ungeschuetzt im Web.
WHO2BE_DOCS_PUBLIC=false

# --- Web Build-Args (Compile-Time, fuer Vite + nginx-Static-Build) ---
VITE_API_BASE_URL=https://api.example.com
VITE_SUPABASE_URL=https://supabase.example.com
VITE_SUPABASE_ANON_KEY=CHANGE_ME_supabase_anon_jwt
# Optional: MCP-Endpoint fuer die Copy-Config am Token. Leer lassen → wird aus
# VITE_API_BASE_URL abgeleitet (api.→mcp., hier https://mcp.example.com/mcp).
# VITE_MCP_URL=https://mcp.example.com/mcp

# --- MCP-Profile (nur wenn `--profile mcp` aktiv) ---
# API-Token aus dem Web-Settings-/v1/tokens-Endpunkt, fuer interne Smoke-Calls.
WHO2BE_API_TOKEN=

# === Cloud-Edition (nur mit docker-compose.cloud.yml-Overlay) =================
# Diese Vars werden NUR vom Cloud-Overlay (who2be/docker-compose.cloud.yml)
# gelesen. Ohne Overlay laeuft der On-Prem-Kern und ignoriert sie.
# WHO2BE_EDITION (=cloud), RATE_LIMIT_STORAGE_URI (=redis://redis:6379) und
# WEB_BASE_URL setzt das Overlay selbst — hier nur die Secrets/Schalter.

# Passwort der nicht-privilegierten Laufzeit-Rolle `who2be_app` (Migration 0036
# legt die Rolle an; der One-Shot `set-app-role-password` setzt das Passwort).
# Frei waehlbar, stark — landet in APP_DATABASE_URL. NICHT der POSTGRES_PASSWORD!
APP_DB_PASSWORD=CHANGE_ME_who2be_app_password

# Service-Role-JWT (mit JWT_SECRET signiert, role=service_role) — fuer GoTrue-
# Admin-Calls (Invitations, Account-Loeschung). Erzeugung wie ANON_KEY:
#   uv run python scripts/gen_test_jwt.py --secret "$JWT_SECRET" --role service_role
SUPABASE_SERVICE_KEY=

# --- Billing (Mollie) — optional ---
# Leer lassen ⇒ /v1/billing-Pfade liefern 503. Fuer einen Solo-Test reicht das:
# das Pro-Entitlement laesst sich per CLI setzen (RUNBOOK → Cloud-Smoke):
#   docker compose ... exec api who2be-set-entitlement <ORG_ID> pro
# Test-Key (test_…) fuer den Checkout-Pfad; Live-Key erst bei echten Kunden.
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=
# Oeffentliche Webhook-URL hinter Caddy (Mollie akzeptiert kein localhost):
MOLLIE_WEBHOOK_URL=https://api.example.com/v1/billing/mollie/webhook

# --- Backup (C5a + C5b) — nur fuer `--profile backup` ---
# Postgres-Zugang fuer den Backup-Container. db-Service lebt im supabase-Stack.
POSTGRES_HOST=db
POSTGRES_USER=supabase_admin
POSTGRES_DB=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# GPG-Recipient fuer den lokalen pg_dump (ADR-0011). Key-ID oder Email.
# Setup-Anleitung im RUNBOOK → "Backup & Restore".
BACKUP_GPG_RECIPIENT=who2be-backup@example.org

# Host-Pfade, die in den Backup-Container gemountet werden.
# Auf Hetzner liegen Secrets in /opt/who2be/secrets/{gpg,ssh} (Mode 600/700).
# Fuer lokales Probelauf z.B. BACKUP_GPG_HOME=$HOME/.gnupg setzen.
# BACKUP_GPG_HOME=/opt/who2be/secrets/gpg
# BACKUP_SSH_HOME=/opt/who2be/secrets/ssh

# Offsite-Sync via restic. Leer = lokal-only Modus (kein restic-Lauf).
# Hetzner Storage Box: sftp:u123456@u123456.your-storagebox.de:/who2be-backup
RESTIC_REPOSITORY=
RESTIC_PASSWORD=CHANGE_ME_restic_repo_password
