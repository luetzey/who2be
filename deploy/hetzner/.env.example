# === Hetzner Prod-App-Stack (deploy/hetzner/who2be/docker-compose.yml) ===
# Auf dem Hetzner-Server nach deploy/hetzner/.env kopieren und ausfuellen.

# --- Domain + ACME ---
DOMAIN=example.com                       # api.<DOMAIN> und app.<DOMAIN>
ACME_EMAIL=admin@example.com             # Let's-Encrypt-Kontakt-Adresse

# --- Image-Tags (C4 setzt diese per CI/CD auf den Commit-SHA) ---
API_IMAGE_TAG=latest
WEB_IMAGE_TAG=latest
MCP_IMAGE_TAG=latest

# --- Backend ---
# DATABASE_URL zeigt auf den Supabase-Postgres-Service-Namen (Task C2).
DATABASE_URL=postgresql://supabase_admin:CHANGE_ME@db:5432/postgres

# JWT_SECRET muss EXAKT dem Supabase-Project-JWT-Secret entsprechen.
# Mindestens 32 Zeichen (sonst Lifespan-Crash, siehe docs/security-findings.md F-08).
JWT_SECRET=CHANGE_ME_minimum_32_chars

# Issuer-Pruefung im API-Auth-Pfad (F-03).
SUPABASE_URL=https://supabase.example.com

# Komma-separierte CORS-Whitelist — nur die App-Domain.
CORS_ORIGINS=https://app.example.com

# Optional — Default 30/minute (apps/api/src/who2be_api/core/config.py).
# RATE_LIMIT_WRITE=30/minute

# Optional — Default json.
# LOG_FORMAT=json

# Docs-Toggle (H5 / F-13). Default false: /docs, /redoc, /openapi.json sind aus.
# Aktivieren nur fuer einmaliges Debugging gegen Prod, sonst stehen Schema und
# Routes ungeschuetzt im Web.
WHO2BE_DOCS_PUBLIC=false

# --- Web Build-Args (Compile-Time, fuer Vite + nginx-Static-Build) ---
VITE_API_BASE_URL=https://api.example.com
VITE_SUPABASE_URL=https://supabase.example.com
VITE_SUPABASE_ANON_KEY=CHANGE_ME_supabase_anon_jwt

# --- MCP-Profile (nur wenn `--profile mcp` aktiv) ---
# API-Token aus dem Web-Settings-/v1/tokens-Endpunkt, fuer interne Smoke-Calls.
WHO2BE_API_TOKEN=
