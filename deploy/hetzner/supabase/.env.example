# === Hetzner Supabase-Stack (deploy/hetzner/supabase/docker-compose.yml) ===
# Auf dem Hetzner-Server nach deploy/hetzner/supabase/.env kopieren und ausfuellen.

# Domain (gleich wie in deploy/hetzner/.env)
DOMAIN=example.com

# --- Postgres ---
# Mindestens 20 Zeichen, alphanumerisch + Sonderzeichen.
POSTGRES_PASSWORD=CHANGE_ME

# --- JWT ---
# WICHTIG: identischer Wert wie JWT_SECRET in ../.env (C3).
# Mindestens 32 Zeichen (sonst Lifespan-Crash in der Who2Be-API, F-08).
JWT_SECRET=CHANGE_ME_minimum_32_chars
JWT_EXP=3600

# --- GoTrue / Site ---
SITE_URL=https://app.example.com

# --- Anon / Service-Role Tokens ---
# Erzeugen mit:
#   uv run python scripts/gen_test_jwt.py --secret "$JWT_SECRET" \
#       --role anon --exp 315360000 > .anon.jwt
#   uv run python scripts/gen_test_jwt.py --secret "$JWT_SECRET" \
#       --role service_role --exp 315360000 > .service.jwt
# Beide Werte HIER eintragen UND in ../.env (VITE_SUPABASE_ANON_KEY).
ANON_KEY=CHANGE_ME_generated_anon_jwt
SERVICE_ROLE_KEY=CHANGE_ME_generated_service_role_jwt

# --- Studio (Profil: studio) ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME
