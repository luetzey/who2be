# Reverse-Proxy fuer den Hetzner-App-Stack.
# Auto-HTTPS via Let's-Encrypt. Erwartete Env-Vars (siehe ../.env.example):
#   DOMAIN, ACME_EMAIL, VITE_SUPABASE_URL.
# Adressiert F-12 (security-findings.md): Security-Header werden zentral hier
# gesetzt, statt in jeder Antwort der API/des Webs.

{
    email {$ACME_EMAIL}
}

# Reusable Security-Header — HSTS schon via Caddys Auto-HTTPS gegeben, hier
# explizit fuer Klarheit; `-Server` versteckt das Caddy-Banner.
# Cross-Origin-Opener-Policy isoliert den Browsing-Context (kein window-Handle
# fuer cross-origin Opener) — schliesst die letzte Header-Luecke aus F-12.
(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), microphone=()"
        Cross-Origin-Opener-Policy "same-origin"
        -Server
    }
}

# Access-Logs. Ohne sie faellt nur ein AUSFALL auf, nie ein Zugriff — eine
# nachtraegliche Rekonstruktion waere unmoeglich, weil die Daten gar nicht erst
# entstehen. Wird in jeden Site-Block importiert.
#
# Ablage auf einem Volume (`caddy-logs`, s. who2be/docker-compose.yml) statt im
# Container-Dateisystem: BSI SYS.1.6.A7 (Basis-Anforderung, Edition 2023)
# verlangt woertlich, dass „[d]ie Speicherung der Protokollierungsdaten der
# Container … ausserhalb des Containers, mindestens auf dem Container-Host,
# erfolgen" MUSS. A7 fordert NICHT die Existenz von Access-Logs — nur, dass
# vorhandene Protokolldaten den Container ueberleben.
#
# Rotation ist Pflicht und nicht Kuer: eine unbegrenzt wachsende Logdatei ist
# ein selbstgebauter Ausfall (volle Platte). Obergrenze hier ~10 MiB aktiv +
# 10 gzip-komprimierte Generationen.
#
# Datenschutz (V12 im VVT, Art. 6 Abs. 1 lit. f): Access-Logs enthalten
# IP-Adressen und User-Agents. Aufbewahrung: 14 Tage, im Korridor von
# docs/compliance/data-retention-and-erasure.md §5 (7–30 Tage).
#
# WIE die Frist durchgesetzt wird — und warum nicht hier:
#   * Die Direktiven unten deckeln die GROESSE, nicht die Zeit. `roll_keep_for`
#     wirkt ausschliesslich auf bereits rotierte Generationen und laeuft erst,
#     wenn eine neue Datei entsteht; die aktive `access.log` erfasst es nie.
#   * Den zeitlichen Teil traegt deshalb ein Host-Cron, wie schon bei Backup
#     und Retention-Purge: taeglich rotieren, Generationen aelter als 14 Tage
#     loeschen. Einrichtung und Nachweis: RUNBOOK §Access-Logs.
#     `roll_keep_for` bleibt als zweite, unabhaengige Grenze gesetzt — faellt
#     der Cron aus, raeumt es bei der naechsten groessenbedingten Rotation auf.
#   * Seit der Anhebung auf Caddy 2.11 (Juni 2026) kennt der file-Writer
#     `roll_at` und wuerde einen zeitlichen Ausloeser selbst tragen; unter 2.8
#     verwarf er die Zeile still. Der Cron bleibt trotzdem der Mechanismus:
#     `roll_at` rotiert nur, es LOESCHT nichts — die Frist braucht beides, und
#     der Cron tut beides in einer Zeile. Ein Wechsel waere eine eigene
#     Aenderung mit eigenem Nachweis, nicht ein Nebeneffekt des Versionssprungs.
#   * Cookie/Set-Cookie/Authorization/Proxy-Authorization redigiert Caddy per
#     Default zu `REDACTED`; die globale Server-Option `log_credentials`, die
#     das abschalten wuerde, ist bewusst NICHT gesetzt.
#   * Query-Werte sind NICHT per Default geschuetzt: api.{$DOMAIN} traegt den
#     OAuth-Authorization-Endpunkt (ADR-0036), also stehen dort `code`- und
#     `token`-Werte in der URL. Der Filter ersetzt sie, BEVOR etwas auf Platte
#     geht.
#   * Dateirechte bleiben beim Writer-Default 0600 (nur der Caddy-Prozess).
#     Ein expliziter `mode`-Unterbefehl waere ab 2.11 wirksam (unter 2.8 wurde
#     er still verworfen), wuerde hier aber nur den Default wiederholen.
(access_log) {
    log {
        output file /var/log/caddy/access.log {
            roll_size 10MiB
            roll_keep 10
            roll_keep_for 336h
        }
        format filter {
            request>uri query {
                replace code REDACTED
                replace token REDACTED
                replace access_token REDACTED
                replace refresh_token REDACTED
            }
        }
    }
}

api.{$DOMAIN} {
    import security_headers
    import access_log
    # API liefert JSON — Inline-Scripts, Frames, Plugins, Form-Posts und externe
    # Connects sind alle aus. `object-src`/`form-action` explizit, weil Letzteres
    # NICHT auf `default-src` zurueckfaellt (sonst Form-Hijack-Luecke).
    header Content-Security-Policy "default-src 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'none'"
    # H5 / ADR-0010: /v1/internal/* (z.B. /metrics fuer Prometheus) ist ausschliesslich
    # intern erreichbar. Caddy blockt externen Zugriff direkt — kein Round-Trip in den
    # Container, damit auch versehentlich offene Endpoints nicht raus-leaken.
    @internal path /v1/internal/*
    respond @internal "Forbidden" 403
    # Body-Limit VOR der App (Security-Review 2026-08-13 M1): das Ingest-Limit
    # ist 20 MiB Nutzdaten (WHO2BE_INGEST_MAX_BYTES) — 32 MB deckt Base64-
    # Overhead + JSON-Rahmen; groessere Bodies verwirft Caddy, bevor Starlette
    # sie puffert.
    request_body {
        max_size 32MB
    }
    reverse_proxy api:8000
}

app.{$DOMAIN} {
    import security_headers
    import access_log
    # SPA-CSP: Vite-Build hat keine Inline-Scripts, aber Inline-Styles (CSSinJS,
    # BlockNote-Insel ADR-0022). connect-src haelt die eigene API + die
    # Supabase-Instanz erlaubt. `object-src 'none'` killt Plugin-XSS,
    # `form-action 'self'` verhindert Form-Hijack (kein default-src-Fallback).
    header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.{$DOMAIN} {$VITE_SUPABASE_URL}; object-src 'none'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'"
    reverse_proxy web:80
}

supabase.{$DOMAIN} {
    import security_headers
    import access_log
    # GoTrue-Endpunkt (Auth). CORS macht der auth-gateway-Container selbst,
    # CSP hier bewusst sehr restriktiv, weil es keine HTML-Antworten gibt.
    header Content-Security-Policy "default-src 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'none'"
    reverse_proxy auth-gateway:9999
}

# MCP-Streamable-HTTP-Endpunkt (ADR-0034). Aktiv nur bei `--profile mcp-http`
# im App-Compose; ohne aktiven Backend-Container antwortet Caddy mit 502.
# Auth: Bearer-Token (am Agenten erzeugt, `/v1/tokens`). Caddy reicht
# `Authorization` unveraendert weiter; der MCP-Server wertet den Header pro
# Request aus (Multi-Tenant, ADR-0034) — jede Session agiert als ihr eigener,
# serverseitig gescopter Token/Agent.
mcp.{$DOMAIN} {
    import security_headers
    import access_log
    # Streamable-HTTP liefert SSE-Frames (`text/event-stream`); HTML-Inline-Code
    # gibt es nicht, deshalb harte CSP — Browser sollten den Endpoint sowieso
    # nicht direkt anfassen (MCP-Clients sind native bzw. Server-to-Server).
    header Content-Security-Policy "default-src 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'none'"
    reverse_proxy mcp-http:8765 {
        # SSE braucht Read-Streaming; Default-Buffer wuerde Frames verschlucken.
        flush_interval -1
    }
}
